# ============================================================================
# TRIARCHS OF OLYMPUS — server-side configuration
#
# VARIABLE NAMES ONLY. Never commit a real value to this file, and never copy
# one of these into js/config.js or any other file the browser downloads.
#
# WHERE THESE ACTUALLY LIVE. This file is documentation. The real values are
# set as Supabase Edge Function secrets:
#
#     supabase secrets set NAME=value --project-ref <ref>
#
# or through Dashboard -> Edge Functions -> Secrets. They are readable only by
# the functions in supabase/functions/, never by the website.
#
# THE PUBLIC HALF is deliberately NOT here: the Supabase URL, the Supabase
# publishable key, the Turnstile SITE key and the Stripe PUBLISHABLE key all
# live in js/config.js, in the open, on purpose. Row Level Security is what
# protects the data — not the secrecy of those four strings.
# ============================================================================


# ---------------------------------------------------------------------------
# Supabase — injected automatically into Edge Functions
# ---------------------------------------------------------------------------
# These three are provided by the platform at runtime. You do NOT need to set
# them yourself; they are listed so it is clear what the functions rely on.
#
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY          <- bypasses RLS. Server-side only. Ever.


# ---------------------------------------------------------------------------
# Signup gate
# ---------------------------------------------------------------------------
# A long random string used to HMAC visitor IP addresses before they are
# stored. Losing it means the existing rate-limit records stop matching (the
# limits simply reset); leaking it means the stored digests become reversible,
# because the IPv4 address space is small enough to enumerate against a known
# key. Generate with:  openssl rand -base64 48
SIGNUP_IP_HMAC_SECRET=

# Absolute URL the confirmation email should return to. Must also be listed
# under Authentication -> URL Configuration -> Redirect URLs in Supabase.
# e.g. https://alucasol.github.io/Olympus/confirm.html
SIGNUP_CONFIRM_REDIRECT_URL=


# ---------------------------------------------------------------------------
# Cloudflare Turnstile
# ---------------------------------------------------------------------------
# The SECRET key from Cloudflare -> Turnstile -> your widget.
#
# NOTE THAT THIS IS A SECOND HOME FOR IT. Supabase Auth already holds the same
# secret under Authentication -> Attack Protection, and that copy is what
# verifies the CAPTCHA on sign-up, sign-in and recovery. Auth will not verify a
# token for anything else, and an Edge Function cannot read Auth's copy — so
# change-username has to ask Cloudflare itself, with its own copy. Set it in
# both places, and rotate it in both places.
#
# If this is unset, change-username refuses every request rather than failing
# open. That is deliberate: a silently disabled check is worse than a visibly
# broken one.
TURNSTILE_SECRET_KEY=


# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# TEST MODE while building. sk_test_... — never sk_live_... until you have
# deliberately decided to go live.
STRIPE_SECRET_KEY=

# From Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing
# secret. Begins whsec_. This is what proves an incoming webhook really came
# from Stripe; without it, anyone could POST a "payment succeeded" event.
STRIPE_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Base URL used to build the Stripe success and cancel redirects. No trailing
# slash. e.g. https://alucasol.github.io/Olympus
SITE_URL=

# Comma-separated CORS allow-list for the authenticated Edge Functions.
# Never "*". Drop the localhost entry when you deploy for real.
# e.g. https://alucasol.github.io,http://localhost:8080
ALLOWED_ORIGINS=


# ---------------------------------------------------------------------------
# Scheduled cleanup
# ---------------------------------------------------------------------------
# Shared secret for invoking cleanup-unconfirmed by hand. The scheduler can
# use the service-role key instead, so this is only for manual runs.
# Generate with:  openssl rand -hex 32
CLEANUP_SECRET=


# ---------------------------------------------------------------------------
# Resend (Supabase custom SMTP)
# ---------------------------------------------------------------------------
# NOT an Edge Function secret. The Resend API key is entered directly into
# Supabase -> Project Settings -> Authentication -> SMTP Settings, as the SMTP
# password. It is recorded here only so the name is documented.
#
# RESEND_SMTP_PASSWORD    (host smtp.resend.com, port 465, username "resend")
